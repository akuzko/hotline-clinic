{
  "name": "@hotline/api",
  "private": true,
  "type": "module",
  "exports": {
    "./router": "./src/trpc/router.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "notify": "tsx --env-file-if-exists=../../.env scripts/notify.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@hotline/shared": "*",
    "@trpc/server": "11.28.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "postgres": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
